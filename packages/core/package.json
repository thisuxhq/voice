{
  "name": "@thisux/voice-core",
  "version": "0.0.1",
  "description": "Core SDK for THISUX Voice — createVoice, pipeline, tools, middleware",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
